      "parameters": {
        "jsCode": "const keywords = [\n  \"artificial intelligence\",\n  \"machine learning\",\n  \"deep learning\",\n  \"ai engineer\",\n  \"ml engineer\",\n  \"llm\",\n  \"generative ai\",\n  \"ai automation\",\n  \"n8n\",\n  \"rag\",\n  \"computer vision\",\n  \"nlp\"\n];\n\nreturn items.filter(item => {\n  const job = item.json;\n\n  const text = [\n    job.title || \"\",\n    job.category || \"\",\n    ...(job.tags || [])\n  ].join(\" \").toLowerCase();\n\n  return keywords.some(keyword => text.includes(keyword));\n});"
